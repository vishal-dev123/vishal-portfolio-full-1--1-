# Copy this file to .env and fill in your real values. Never commit .env to GitHub.

# The Gmail address that will send and receive contact-form emails
EMAIL_USER=sainisaab123451@gmail.com

# A 16-character Gmail "App Password" (NOT your normal Gmail password).
# Generate one at: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be turned on for your Google account.)
EMAIL_PASS=your16charapppassword

# The origin allowed to call this API — your GitHub Pages URL
ALLOWED_ORIGIN=https://vishal-dev123.github.io

# Port the server listens on (most hosts set this automatically)
PORT=3000
